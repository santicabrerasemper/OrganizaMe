<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pantallaListaActividades"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <Button
        android:id="@+id/btnVolverLista"
        style="@style/Widget.OrganizaMe.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="← Volver" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Tareas y eventos"
        android:textAppearance="@style/TextAppearance.OrganizaMe.ScreenTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:text="Buscá, filtrá y revisá todas tus actividades."
        android:textAppearance="@style/TextAppearance.OrganizaMe.Body" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                style="@style/Widget.OrganizaMe.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buscar y filtrar"
                    android:textAppearance="@style/TextAppearance.OrganizaMe.SectionTitle" />

                <EditText
                    android:id="@+id/buscarTitulo"
                    style="@style/Widget.OrganizaMe.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="8dp"
                    android:hint="Título o descripción"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textSize="16sp" />

                <Spinner
                    android:id="@+id/filtroCategoria"
                    style="@style/Widget.OrganizaMe.Spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <Spinner
                    android:id="@+id/filtroEstado"
                    style="@style/Widget.OrganizaMe.Spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <Spinner
                    android:id="@+id/filtroPrioridad"
                    style="@style/Widget.OrganizaMe.Spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <Spinner
                    android:id="@+id/filtroTipo"
                    style="@style/Widget.OrganizaMe.Spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btnMostrarTodas"
                    style="@style/Widget.OrganizaMe.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Limpiar filtros" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="Actividades"
                android:textAppearance="@style/TextAppearance.OrganizaMe.SectionTitle" />

            <Button
                android:id="@+id/btnPendientes"
                style="@style/Widget.OrganizaMe.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="start|center_vertical"
                android:text="Pendientes y próximas" />

            <TextView
                android:id="@+id/textoPendientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="Acá aparecerán las tareas pendientes."
                android:textAppearance="@style/TextAppearance.OrganizaMe.Body"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaPendientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingTop="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnVencidas"
                style="@style/Widget.OrganizaMe.Button.DangerTonal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:gravity="start|center_vertical"
                android:text="Vencidas" />

            <TextView
                android:id="@+id/textoVencidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="Acá aparecerán las tareas vencidas."
                android:textAppearance="@style/TextAppearance.OrganizaMe.Body"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaVencidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingTop="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnCompletadas"
                style="@style/Widget.OrganizaMe.Button.SuccessTonal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:gravity="start|center_vertical"
                android:text="Completadas" />

            <TextView
                android:id="@+id/textoCompletadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="Acá aparecerán las tareas completadas."
                android:textAppearance="@style/TextAppearance.OrganizaMe.Body"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaCompletadas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingTop="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnEventos"
                style="@style/Widget.OrganizaMe.Button.BlueTonal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:gravity="start|center_vertical"
                android:text="Eventos" />

            <TextView
                android:id="@+id/textoEventos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="Acá aparecerán los eventos."
                android:textAppearance="@style/TextAppearance.OrganizaMe.Body"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaEventos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingTop="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
