<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <Button
        android:id="@+id/btnVolverCalendario"
        style="@style/Widget.OrganizaMe.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="← Volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tituloCalendario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Calendario"
        android:textAppearance="@style/TextAppearance.OrganizaMe.ScreenTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnVolverCalendario" />

    <TextView
        android:id="@+id/subtituloCalendario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tocá un día para consultar sus actividades."
        android:textAppearance="@style/TextAppearance.OrganizaMe.Body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloCalendario" />

    <LinearLayout
        android:id="@+id/barraMes"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtituloCalendario">

        <Button
            android:id="@+id/btnMesAnterior"
            style="@style/Widget.OrganizaMe.Button.Tonal"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:contentDescription="Mes anterior"
            android:text="‹"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/textoMes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Mes año"
            android:textColor="@color/primary_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMesSiguiente"
            style="@style/Widget.OrganizaMe.Button.Tonal"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:contentDescription="Mes siguiente"
            android:text="›"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/filaDiasSemana"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraMes">

        <TextView style="@style/TextAppearance.OrganizaMe.Label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="L" />
        <TextView style="@style/TextAppearance.OrganizaMe.Label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="M" />
        <TextView style="@style/TextAppearance.OrganizaMe.Label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="X" />
        <TextView style="@style/TextAppearance.OrganizaMe.Label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="J" />
        <TextView style="@style/TextAppearance.OrganizaMe.Label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="V" />
        <TextView style="@style/TextAppearance.OrganizaMe.Label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" />
        <TextView style="@style/TextAppearance.OrganizaMe.Label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="D" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaDiasCalendario"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filaDiasSemana" />

</androidx.constraintlayout.widget.ConstraintLayout>
