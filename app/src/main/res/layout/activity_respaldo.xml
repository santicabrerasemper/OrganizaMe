<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pantallaRespaldo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <Button
        android:id="@+id/btnVolverRespaldo"
        style="@style/Widget.OrganizaMe.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="← Volver" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Respaldo local"
        android:textAppearance="@style/TextAppearance.OrganizaMe.ScreenTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Guardá tus actividades y categorías en un archivo JSON o recuperalas en este dispositivo."
        android:textAppearance="@style/TextAppearance.OrganizaMe.Body" />

    <LinearLayout
        style="@style/Widget.OrganizaMe.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exportar"
            android:textAppearance="@style/TextAppearance.OrganizaMe.SectionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Crea una copia que podés guardar o compartir manualmente."
            android:textAppearance="@style/TextAppearance.OrganizaMe.Body" />

        <Button
            android:id="@+id/btnExportarRespaldo"
            style="@style/Widget.OrganizaMe.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="Exportar respaldo" />
    </LinearLayout>

    <LinearLayout
        style="@style/Widget.OrganizaMe.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Importar"
            android:textAppearance="@style/TextAppearance.OrganizaMe.SectionTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="La importación reemplaza los datos locales después de pedirte confirmación."
            android:textAppearance="@style/TextAppearance.OrganizaMe.Body" />

        <Button
            android:id="@+id/btnImportarRespaldo"
            style="@style/Widget.OrganizaMe.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="Importar respaldo" />
    </LinearLayout>

    <TextView
        android:id="@+id/textoEstadoRespaldo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.OrganizaMe.Body" />
</LinearLayout>
