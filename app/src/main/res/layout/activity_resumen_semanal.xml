<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pantallaResumenSemanal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <Button
        android:id="@+id/btnVolverResumen"
        style="@style/Widget.OrganizaMe.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="← Volver" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resumen semanal"
        android:textAppearance="@style/TextAppearance.OrganizaMe.ScreenTitle" />

    <TextView
        android:id="@+id/textoRangoSemana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.OrganizaMe.Body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSemanaAnterior"
            style="@style/Widget.OrganizaMe.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Anterior" />

        <Button
            android:id="@+id/btnSemanaActual"
            style="@style/Widget.OrganizaMe.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="Actual" />

        <Button
            android:id="@+id/btnSemanaSiguiente"
            style="@style/Widget.OrganizaMe.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Siguiente" />
    </LinearLayout>

    <TextView
        android:id="@+id/textoContadoresSemana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_primary_container"
        android:gravity="center"
        android:padding="16dp"
        android:textAppearance="@style/TextAppearance.OrganizaMe.Body" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contenedorResumenSemana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp" />
    </ScrollView>
</LinearLayout>
