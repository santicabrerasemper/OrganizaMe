<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_primary_container"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.OrganizaMe.Brand" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Tu día, más claro y organizado"
                android:textAppearance="@style/TextAppearance.OrganizaMe.Body"
                android:textColor="@color/primary_dark" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Accesos rápidos"
            android:textAppearance="@style/TextAppearance.OrganizaMe.SectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNuevaTarea"
                style="@style/Widget.OrganizaMe.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="＋ Nueva actividad" />

            <Button
                android:id="@+id/btnHoy"
                style="@style/Widget.OrganizaMe.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Hoy" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCalendario"
                style="@style/Widget.OrganizaMe.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Calendario" />

            <Button
                android:id="@+id/btnCategorias"
                style="@style/Widget.OrganizaMe.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Categorías" />
        </LinearLayout>

        <Button
            android:id="@+id/btnVerActividades"
            style="@style/Widget.OrganizaMe.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Ver todas las tareas y eventos" />



        <Button
            android:id="@+id/btnModoOscuro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Activar modo oscuro"
            android:textSize="16sp"
            android:textAllCaps="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnResumenSemanal"
                style="@style/Widget.OrganizaMe.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Resumen semanal" />

            <Button
                android:id="@+id/btnRespaldo"
                style="@style/Widget.OrganizaMe.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Respaldo" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.OrganizaMe.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carga rápida"
                android:textAppearance="@style/TextAppearance.OrganizaMe.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Escribí una frase y revisá los datos antes de guardarlos."
                android:textAppearance="@style/TextAppearance.OrganizaMe.Body" />

            <EditText
                android:id="@+id/entradaRapida"
                style="@style/Widget.OrganizaMe.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="top|start"
                android:hint="Ej.: estudiar mañana a las 18"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:minHeight="96dp"
                android:minLines="2"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnInterpretar"
                style="@style/Widget.OrganizaMe.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="Interpretar frase" />

            <TextView
                android:id="@+id/btnAyudaParser"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Ver ejemplos y expresiones admitidas"
                android:textColor="@color/secondary"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
