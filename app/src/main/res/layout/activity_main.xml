

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <!-- Título principal -->

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name"
            android:textSize="32sp"
            android:textColor="@color/primary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Organizá tus tareas y eventos"
            android:textColor="@color/on_background"
            android:textSize="16sp" />

        <!-- Accesos rápidos -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="¿Qué querés hacer?"
            android:textSize="20sp"
            android:textColor="@color/on_background"
            android:textStyle="bold" />

        <!-- Primera fila -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnNuevaTarea"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Nueva tarea"
                android:textSize="16sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnHoy"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Hoy"
                android:textSize="16sp"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- Segunda fila -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCalendario"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Calendario"
                android:textSize="16sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnCategorias"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Categorías"
                android:textSize="16sp"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- Ver todas las actividades -->

        <Button
            android:id="@+id/btnVerActividades"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="18dp"
            android:text="Ver tareas y eventos"
            android:textSize="17sp"
            android:textAllCaps="false" />

        <!-- Intérprete de lenguaje natural -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Crear con lenguaje natural"
            android:textSize="20sp"
            android:textColor="@color/on_background"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Escribí lo que necesitás hacer y OrganizaMe te ayudará a crear la actividad."
            android:textColor="@color/on_background"
            android:textSize="16sp" />

        <!-- Campo de texto -->

        <EditText
            android:id="@+id/entradaRapida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="90dp"
            android:layout_marginTop="18dp"
            android:hint="Ej.: estudiar mañana a las 18"
            android:textSize="17sp"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:maxLines="3"
            android:gravity="top"
            android:padding="14dp" />

        <!-- Botón interpretar -->

        <Button
            android:id="@+id/btnInterpretar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="Interpretar"
            android:textSize="17sp"
            android:textAllCaps="false" />

        <!-- Ayuda del intérprete -->

        <TextView
            android:id="@+id/btnAyudaParser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:padding="14dp"
            android:text="¿Qué frases puedo escribir?"
            android:textSize="16sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

