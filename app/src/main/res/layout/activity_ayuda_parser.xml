<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <Button
            android:id="@+id/btnVolverAyuda"
            style="@style/Widget.OrganizaMe.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← Volver" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_primary_container"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carga rápida en español"
                android:textAppearance="@style/TextAppearance.OrganizaMe.ScreenTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Escribí una frase y OrganizaMe completará los campos que reconozca. Siempre vas a poder revisarlos antes de guardar."
                android:textAppearance="@style/TextAppearance.OrganizaMe.Body"
                android:textColor="@color/primary_dark" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.OrganizaMe.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ejemplos"
                android:textAppearance="@style/TextAppearance.OrganizaMe.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="• estudiar mañana a las 18 descripción repasar unidad cinco recordatorio 30 minutos antes\n\n• reunión el viernes a las 10 prioridad alta recordatorio a la hora\n\n• tarea comprar remedios hoy urgente\n\n• turno dentista 15/10/2027 a las 09:30 recordatorio 1 día antes"
                android:textAppearance="@style/TextAppearance.OrganizaMe.Body" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.OrganizaMe.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expresiones reconocidas"
                android:textAppearance="@style/TextAppearance.OrganizaMe.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Fechas\nhoy, mañana, pasado mañana, lunes a domingo, dd/MM/aaaa y dd-MM-aaaa.\n\nHoras\nHH:mm o ‘a las H’.\n\nPrioridad\nalta, media, baja o urgente.\n\nTipo\ntarea, evento, reunión, cita o turno.\n\nDescripción\nescribí ‘descripción’ y luego el detalle.\n\nRecordatorio\na la hora, 10 o 30 minutos antes, 1 hora antes o 1 día antes."
                android:textAppearance="@style/TextAppearance.OrganizaMe.Body" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_warning_container"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Antes de guardar"
                android:textAppearance="@style/TextAppearance.OrganizaMe.SectionTitle"
                android:textColor="@color/warning" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="El parser usa reglas acotadas. Si encuentra datos inválidos, ambiguos o no soportados, te pedirá que los corrijas. Un recordatorio necesita una fecha y una hora futuras."
                android:textAppearance="@style/TextAppearance.OrganizaMe.Body"
                android:textColor="@color/warning" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
