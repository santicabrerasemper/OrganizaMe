<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />


    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OrganizaMe">
        <activity
            android:name=".ui.alarma.PantallaAlarmaActividad"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />
        <activity
            android:name=".ui.inicio.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.formulario.NuevaTareaActividad"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.parser.AyudaParserActividad"
            android:exported="false" />
        <receiver
            android:name=".data.recordatorios.ReceptorRecordatorio"
            android:exported="false" />
        <service
            android:name=".data.recordatorios.ServicioAlarma"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <receiver
            android:name=".data.recordatorios.ReceptorReprogramacion"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".ui.categorias.CategoriasActividad"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.calendario.CalendarioActividad"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.hoy.HoyActividad"
            android:exported="false" />
        <activity
            android:name=".ui.resumen.ResumenSemanalActividad"
            android:exported="false" />
        <activity
            android:name=".ui.respaldo.RespaldoActividad"
            android:exported="false" />

        <activity
            android:name=".ui.lista.ListaActividadesActividad"
            android:exported="false" />
    </application>

</manifest>
